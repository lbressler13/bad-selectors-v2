<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="25dp"
    android:paddingTop="5dp">

    <TextView
        android:id="@+id/seekbarLabel"
        style="@style/SettingsSwitch"
        android:paddingBottom="10dp"
        android:text="@string/num_saved_values"
        android:textColor="?colorOnBackground"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/numSavedValuesSeekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="4"
        android:min="0"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:thumbOffset="0dp"
        app:layout_constraintTop_toBottomOf="@id/seekbarLabel" />

    <TextView
        android:id="@+id/cannotDisableText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/numSavedValuesSeekbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
